<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>AceOption</AssemblyName>
    <RootNamespace>AceOption</RootNamespace>
    <Title>Ace Option</Title>
    <Description>A quality-of-life mod for Nuclear Option, with improved camera controls, a customizable HUD, and an Ace Combat-inspired flying experience.</Description>
    <Version>1.0.2</Version>
    <LangVersion>latest</LangVersion>
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\Nuclear Option</GameDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(GameDir)\NuclearOption_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(GameDir)\NuclearOption_Data\Managed\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(GameDir)\NuclearOption_Data\Managed\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(GameDir)\NuclearOption_Data\Managed\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\NuclearOption_Data\Managed\Assembly-CSharp.dll</HintPath><Private>false</Private>
    </Reference>
    <Reference Include="$(GameDir)\NuclearOption_Data\Managed\Mirage.dll;$(GameDir)\NuclearOption_Data\Managed\Rewired_Core.dll;$(GameDir)\NuclearOption_Data\Managed\UnityEngine.dll;$(GameDir)\NuclearOption_Data\Managed\UnityEngine.CoreModule.dll;$(GameDir)\NuclearOption_Data\Managed\UnityEngine.PhysicsModule.dll;$(GameDir)\NuclearOption_Data\Managed\UnityEngine.AudioModule.dll;$(GameDir)\NuclearOption_Data\Managed\UnityEngine.InputLegacyModule.dll"><Private>false</Private></Reference>
  </ItemGroup>
</Project>
